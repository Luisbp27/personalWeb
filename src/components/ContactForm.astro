---
const inputClasses =
    "w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder:text-gray-500";
const labelClasses = "text-sm font-medium text-gray-900 dark:text-gray-100";
---

<form data-contact-form class="mt-10 flex animate-fade-up flex-col gap-5">
    <div class="flex flex-col gap-2">
        <label for="name" class={labelClasses}>
            Name{" "}
            <span class="text-red-500" aria-hidden="true">
                *
            </span>
        </label>
        <input
            id="name"
            name="name"
            type="text"
            required
            placeholder="Your name"
            autocomplete="name"
            class={inputClasses}
        />
        <p
            data-error-for="name"
            class="hidden text-sm text-red-600 dark:text-red-400"
            aria-live="polite"
        ></p>
    </div>

    <div class="flex flex-col gap-2">
        <label for="email" class={labelClasses}>
            Email{" "}
            <span class="text-red-500" aria-hidden="true">
                *
            </span>
        </label>
        <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="Your email"
            autocomplete="email"
            class={inputClasses}
        />
        <p
            data-error-for="email"
            class="hidden text-sm text-red-600 dark:text-red-400"
            aria-live="polite"
        ></p>
    </div>

    <div class="flex flex-col gap-2">
        <label for="message" class={labelClasses}>
            Message{" "}
            <span class="text-red-500" aria-hidden="true">
                *
            </span>
        </label>
        <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="Tell me what you think"
            class:list={[inputClasses, "resize-y"]}
        ></textarea>
        <p
            data-error-for="message"
            class="hidden text-sm text-red-600 dark:text-red-400"
            aria-live="polite"
        ></p>
    </div>

    <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input
            id="company"
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
        />
    </div>

    <button
        type="submit"
        class="mt-2 inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-base font-medium text-white shadow-sm transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:opacity-60"
    >
        Send
    </button>
</form>
