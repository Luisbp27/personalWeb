---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";
import { tagStyles } from "@/data/projects";

interface Props extends Project {
    delay?: number;
}

const { title, description, image, tags, link, delay = 0 } = Astro.props;
---

<article
    class="group flex animate-fade-up flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900"
    style={`animation-delay: ${delay}ms`}
>
    <Image
        src={image}
        alt={title}
        widths={[400, 800]}
        sizes="(min-width: 640px) 50vw, 100vw"
        class="aspect-video w-full object-cover"
        loading="lazy"
    />
    <div class="flex flex-1 flex-col p-5 sm:p-6">
        <h2 class="text-lg font-semibold sm:text-xl">
            <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 transition hover:text-blue-600 dark:hover:text-blue-400"
            >
                {title}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-4 shrink-0"
                    aria-hidden="true"
                >
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                </svg>
            </a>
        </h2>
        <p class="mt-2 flex-1 text-sm text-gray-600 sm:text-base dark:text-gray-300">
            {description}
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
                <li
                    class:list={[
                        "rounded-full px-2.5 py-1 text-xs font-medium",
                        tagStyles[tag] ??
                            "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
                    ]}
                >
                    {tag}
                </li>
            ))}
        </ul>
    </div>
</article>
