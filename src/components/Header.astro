---
import ThemeToggle from "@/components/ThemeToggle.astro";

interface NavLink {
    href: string;
    label: string;
    external?: boolean;
}

const links: NavLink[] = [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: "/about", label: "About" },
    {
        href: "https://www.linkedin.com/in/luisbarcapons/",
        label: "Contact",
        external: true,
    },
];

const currentPath = Astro.url.pathname;
const isActive = (link: NavLink) =>
    !link.external &&
    (link.href === "/"
        ? currentPath === "/"
        : currentPath.startsWith(link.href));
---

<header
    transition:persist
    class="sticky top-0 z-40 border-b border-gray-200/70 bg-white/80 backdrop-blur dark:border-gray-800/70 dark:bg-gray-950/80"
>
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a
            href="/"
            class="text-lg font-semibold tracking-tight transition hover:text-blue-600 dark:hover:text-blue-400"
        >
            Luis Barca
        </a>

        <div class="flex items-center gap-1">
            <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
                {links.map((link) => (
                    <a
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        aria-current={isActive(link) ? "page" : undefined}
                        class:list={[
                            "rounded-md px-3 py-2 text-sm font-medium transition hover:bg-gray-100 dark:hover:bg-gray-800",
                            isActive(link)
                                ? "text-blue-600 dark:text-blue-400"
                                : "text-gray-600 dark:text-gray-300",
                        ]}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>

            <ThemeToggle />

            <details class="relative md:hidden">
                <summary
                    class="flex size-9 cursor-pointer list-none items-center justify-center rounded-md text-gray-600 transition hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800 [&::-webkit-details-marker]:hidden"
                    aria-label="Open menu"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-5"
                        aria-hidden="true"
                    >
                        <line x1="4" x2="20" y1="12" y2="12"></line>
                        <line x1="4" x2="20" y1="6" y2="6"></line>
                        <line x1="4" x2="20" y1="18" y2="18"></line>
                    </svg>
                </summary>
                <nav
                    class="absolute top-full right-0 mt-2 w-44 rounded-xl border border-gray-200 bg-white p-2 shadow-lg dark:border-gray-800 dark:bg-gray-900"
                    aria-label="Mobile"
                >
                    {links.map((link) => (
                        <a
                            href={link.href}
                            target={link.external ? "_blank" : undefined}
                            rel={
                                link.external
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                            aria-current={isActive(link) ? "page" : undefined}
                            class:list={[
                                "block rounded-md px-3 py-2 text-sm font-medium transition hover:bg-gray-100 dark:hover:bg-gray-800",
                                isActive(link)
                                    ? "text-blue-600 dark:text-blue-400"
                                    : "text-gray-600 dark:text-gray-300",
                            ]}
                        >
                            {link.label}
                        </a>
                    ))}
                </nav>
            </details>
        </div>
    </div>
</header>
