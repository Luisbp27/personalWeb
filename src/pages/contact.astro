    description="Get in touch with Luis Barca for projects, collaboration or consultancy."
>
    <section class="mx-auto flex max-w-md flex-col px-6 py-16 sm:py-20">
        <h1 class="animate-fade-up text-center text-4xl font-semibold tracking-tight sm:text-5xl">
            Contact Me
        </h1>
        <ContactForm />
    </section>
</Layout>
