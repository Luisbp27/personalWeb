---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
---

<Layout
    title="Projects — Luis Barca"
    description="A selection of data science, machine learning and systems projects by Luis Barca."
>
    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <header class="animate-fade-up">
            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
                Projects
            </h1>
            <p class="mt-3 max-w-xl text-gray-600 dark:text-gray-300">
                A selection of projects I have worked on: data analysis, machine
                learning and low-level systems.
            </p>
        </header>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 sm:gap-8">
            {projects.map((project, index) => (
                <ProjectCard {...project} delay={index * 80} />
            ))}
        </div>
    </section>
</Layout>
